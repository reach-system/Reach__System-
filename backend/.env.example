# Supabase PostgreSQL only. Do not put Supabase API keys in these variables.
# Replace the example connection_limit after confirming the backend PM2 instance count.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"

# Use the direct host if the backend server supports IPv6; otherwise use the
# Supabase session-mode pooler URI here. This URL is for Prisma migrations and
# maintenance tools; do not use the transaction-mode pooler for pg_dump/restore.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# One-off data migration source, archive and backup settings. Store actual
# values only in the server's ignored local environment/secret manager.
SOURCE_DATABASE_URL=
MIGRATION_DUMP_PATH=
BACKUP_DIR=
BACKUP_DATABASE_URL=
RESTORE_ARCHIVE=
RESTORE_TARGET_URL=
DB_SIZE_HISTORY_PATH=
